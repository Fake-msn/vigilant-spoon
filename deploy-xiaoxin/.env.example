# ===== 小信部署环境变量（复制为 .env 并填写）=====

# 域名（必须已解析 A 记录到 139.155.132.128，且已 ICP 备案）
DOMAIN=your.domain.com

# 管理员后台登录密码（务必改为强密码）
ADMIN_PASSWORD=change-me-strong

# ---------- DashScope 真实 AI 服务（可选，留空则整体回退到演示默认）----------
# 语音实时 / 文本 LLM / 文生图 / RAG embedding 可共用一把 key
DASHSCOPE_API_KEY=sk-xxxx
TEXT_API_KEY=sk-xxxx
IMAGE_API_KEY=sk-xxxx
EMBED_API_KEY=sk-xxxx

# 各域提供方（默认 dashscope；如需演示本地/模板/占位，改为 local/template/placeholder/disabled）
VOICE_PROVIDER=dashscope
TEXT_PROVIDER=dashscope
IMAGE_PROVIDER=dashscope
EMBED_PROVIDER=dashscope